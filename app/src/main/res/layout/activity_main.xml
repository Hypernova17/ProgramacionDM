<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">


    <androidx.cardview.widget.CardView
        android:layout_width="150dp"
        android:layout_height="128dp"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="127dp"
            android:contentDescription="Logo de la tienda"
            android:scaleType="centerCrop"
            android:src="@drawable/videojuego_inicio" />

    </androidx.cardview.widget.CardView>

    <!-- Etiqueta (TextView) -->

    <!-- Caja de texto (EditText) -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:text="¡Bienvenido a PuchalePlay!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#96046F04"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Busca el videojuego"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"
        android:textColor="#B106A4"/>

    <!-- Etiqueta para las opciones -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de pedido:"
        android:textStyle="bold"
        android:textColor="#FAA60DEB"/>

    <!-- Radio Buttons -->
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Físico"
            android:checked="true"
            android:textColor="#000000"/>

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digital"
            android:textColor="#000000"/>
    </RadioGroup>

    <!-- Etiqueta para los extras -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extras:"
        android:textStyle="bold"
        android:textColor="#B429DE"/>

    <!-- CheckBox -->
    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar estuche especial"/>

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar poster exclusivo"
        android:layout_marginBottom="24dp"/>

    <!-- Botón -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continuar al resumen de la compra"
        android:textColor="#000000"/>

</LinearLayout>